# Cloudflare Pages / Netlify. COOP + COEP: the game needs SharedArrayBuffer.
# The rest hardens the page (security audit, M2). script-src needs
# 'wasm-unsafe-eval' to compile ac3.wasm and render.wasm.
# Cache-Control is set per file type, never twice for one file (hosts join
# repeated headers): page and code are revalidated on every visit, so an
# update never mixes an old app.js with a new ac3.wasm.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

/*.wasm
  Content-Type: application/wasm
  Cache-Control: no-cache

/patches/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
