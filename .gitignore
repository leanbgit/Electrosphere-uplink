__pycache__/
*.pyc

# Written while playing or testing
/saves/
/ac3_settings.ini
/capture/
/captures_hd/
/selftest_out/
/*.ppm
/vram.bin
/memdump.bin

# Web build output
/build-web/
/web/dist/
/web/dist-public/
/build-tests/
/site/
/build-web/wgsl/

